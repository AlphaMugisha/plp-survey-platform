# =============================================================================
# PLP Survey Platform — environment configuration
# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is git-ignored. Never commit real credentials.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / public key. Safe to expose to the browser: it is gated by RLS and can
# only read active survey content.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SERVER ONLY — it bypasses RLS.
# Never prefix this with NEXT_PUBLIC_ and never reference it in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Random secret used to hash submission IP addresses (raw IPs are never stored).
# Leave blank to store no IP hash at all. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Canonical public URL. LEAVE BLANK unless you need it.
# Auth email links use the browser's own origin, so the same build works on
# localhost and in production with no change. Set this only when the browser
# cannot see the real public URL (behind a reverse proxy), or to force one
# canonical domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=
