{
  "name": "plp-survey-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Peace and Love Proclaimers — PLP School Curriculum survey platform",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "predev": "node scripts/guard-next-cache.mjs dev",
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
